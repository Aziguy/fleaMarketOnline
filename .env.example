# Copier en .env puis adapter. Voir https://aziguy.github.io/fleaMarketOnline/developpeur/configuration/

# Django
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=change-me-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=mfoundimall.cm,www.mfoundimall.cm
CSRF_TRUSTED_ORIGINS=https://mfoundimall.cm,https://www.mfoundimall.cm
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0

# Base de données
POSTGRES_DB=mfoundi
POSTGRES_USER=mfoundi
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://mfoundi:change-me@db:5432/mfoundi

# E-mail (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Mfoundi Mall <no-reply@mfoundimall.cm>
ADMINS=Admin Mall:admin@mfoundimall.cm

# Informations du mall
SITE_NAME=Mfoundi Mall
SITE_PHONE=+237 6 00 00 00 00
SITE_EMAIL=contact@mfoundimall.cm
MALL_ADDRESS=Marché Mfoundi, Yaoundé, Cameroun

LOG_LEVEL=INFO
# json (défaut en production) ou text
LOG_FORMAT=json
APP_VERSION=1.0.0

# Cache : mémoire locale par défaut, Redis recommandé en production
CACHE_URL=redis://redis:6379/1
