# Copier en .env puis adapter. Voir https://aziguy.github.io/fleaMarketOnline/developpeur/configuration/

# Django
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=change-me-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=mfoundimall.cm,www.mfoundimall.cm
CSRF_TRUSTED_ORIGINS=https://mfoundimall.cm,https://www.mfoundimall.cm
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0

# Base de données
POSTGRES_DB=mfoundi
POSTGRES_USER=mfoundi
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://mfoundi:change-me@db:5432/mfoundi

# E-mail (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Mfoundi Mall <no-reply@mfoundimall.cm>
ADMINS=Admin Mall:admin@mfoundimall.cm

# Informations du mall
SITE_NAME=Mfoundi Mall
SITE_PHONE=+237 6 00 00 00 00
SITE_EMAIL=contact@mfoundimall.cm
MALL_ADDRESS=Marché Mfoundi, Yaoundé, Cameroun

LOG_LEVEL=INFO
# json (défaut en production) ou text
LOG_FORMAT=json
APP_VERSION=1.0.0

# Cache : mémoire locale par défaut, Redis recommandé en production
CACHE_URL=redis://redis:6379/1

# Assistant IA (Claude). Sans clé, l'assistant est désactivé et ses boutons masqués.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=30
AI_DESCRIPTIONS_PER_HOUR=30

# Sécurité des comptes
# Clé de chiffrement des applications d'authentification : à générer une fois et à sauvegarder.
# Sans elle, changer SECRET_KEY désactive les applications d'authentification déjà configurées.
MFA_ENCRYPTION_KEY=change-me-with-another-long-random-string
# Domaine des clés d'accès (sans https:// ni port). Ne plus le changer une fois des clés créées.
WEBAUTHN_RP_ID=mfoundimall.cm
# Proxys devant Django qui ajoutent X-Forwarded-For : 1 (Nginx du conteneur), 2 avec un proxy HTTPS sur l'hôte.
TRUSTED_PROXY_COUNT=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=100
LOGIN_LOCKOUT_SECONDS=900
MFA_REQUIRED_FOR_STAFF=True
MFA_TRUSTED_DAYS=30
